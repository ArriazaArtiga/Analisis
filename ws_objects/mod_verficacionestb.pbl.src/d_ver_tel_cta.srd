table(column=(type=char(15) updatewhereclause=yes key=yes name=dpi dbname="contribuyentes.dpi" )
 column=(type=char(30) updatewhereclause=yes name=nombres dbname="contribuyentes.nombres" )
 column=(type=char(100) updatewhereclause=yes name=apellidos dbname="contribuyentes.apellidos" )
 column=(type=char(100) updatewhereclause=yes name=casada dbname="contribuyentes.casada" )
 column=(type=char(10) update=yes updatewhereclause=yes name=telefono dbname="contribuyentes.telefono" )
 column=(type=number update=yes updatewhereclause=yes name=tel_verificado dbname="contribuyentes.tel_verificado" values="	1/	0" )
 column=(type=char(50) update=yes updatewhereclause=yes name=cuenta_bancaria dbname="contribuyentes.cuenta_bancaria" )
 column=(type=number update=yes updatewhereclause=yes name=cta_verificada dbname="contribuyentes.cta_verificada" values="	1/	0" )
 column=(type=char(15) update=yes updatewhereclause=yes name=telverby dbname="contribuyentes.telverby" )
 column=(type=char(15) update=yes updatewhereclause=yes name=ctaverby dbname="contribuyentes.ctaverby" )
 column=(type=char(15) update=yes updatewhereclause=yes name=usuario_modifica dbname="contribuyentes.usuario_modifica" )
 column=(type=datetime update=yes updatewhereclause=yes name=fecha_modifica dbname="contribuyentes.fecha_modifica" )
 retrieve="
SELECT
	c.DPI,
	c.Nombres,
	c.Apellidos,
	c.Casada,
	c.Telefono,
	c.Tel_Verificado,
	c.Cuenta_Bancaria,
	c.Cta_Verificada,
	c.TelVerBy,
	c.CtaVerBy,
	c.Usuario_Modifica,
	c.Fecha_Modifica 
FROM
	Contribuyentes c
WHERE
	c.Cuenta_Bancaria is not null
	and c.Telefono is not null
	and (c.Cta_Verificada = 0 and Tel_Verificado = 0)
	or  (c.Cta_Verificada = 1 and Tel_Verificado = 0)
	or  (c.Cta_Verificada = 0 and Tel_Verificado = 1)" update="Contribuyentes" updatewhere=1 updatekeyinplace=no )

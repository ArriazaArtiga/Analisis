table(column=(type=decimal(0) updatewhereclause=yes key=yes name=detalle_beneficiarios_correlativo dbname="detalle_beneficiarios.correlativo" )
 column=(type=char(254) updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=char(30) update=yes updatewhereclause=yes name=detalle_beneficiarios_telefono dbname="detalle_beneficiarios.telefono" )
 column=(type=number update=yes updatewhereclause=yes name=detalle_beneficiarios_tel_verificado dbname="detalle_beneficiarios.tel_verificado" values="	1/	0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=detalle_beneficiarios_cuenta_banco dbname="detalle_beneficiarios.cuenta_banco" )
 column=(type=number update=yes updatewhereclause=yes name=detalle_beneficiarios_cta_verificada dbname="detalle_beneficiarios.cta_verificada" values="	1/	0" )
 column=(type=char(15) update=yes updatewhereclause=yes name=detalle_beneficiarios_telverby dbname="detalle_beneficiarios.telverby" )
 column=(type=char(15) update=yes updatewhereclause=yes name=detalle_beneficiarios_ctaverby dbname="detalle_beneficiarios.ctaverby" )
 column=(type=char(15) update=yes updatewhereclause=yes name=detalle_beneficiarios_usuario_modifica dbname="detalle_beneficiarios.usuario_modifica" )
 column=(type=datetime update=yes updatewhereclause=yes name=detalle_beneficiarios_fecha_modifica dbname="detalle_beneficiarios.fecha_modifica" )
 retrieve="SELECT
	db2.Correlativo,
	CONCAT(db2.Nombre1,' ',db2.Nombre2,' ',db2.Apellido1,' ',db2.Apellido2,'',db2.ApellidoC) nombre, 
	db2.Telefono,
	db2.Tel_Verificado,
	db2.Cuenta_Banco,
	db2.Cta_Verificada,
	db2.TelVerBy,
	db2.CtaVerBy,
	db2.Usuario_Modifica,
	db2.Fecha_Modifica
FROM
	Contribuyentes c,
	Declaracion_Beneficiarios db,
	Detalle_Beneficiarios db2,
	Solicitudes s
WHERE
	c.DPI = db.DPI_Contribuyente
	AND db.idFormulario = db2.idFormulario
	AND s.DPI = c.DPI
	AND	s.Etapa = 160
	AND	db2.Cuenta_Banco is not null
	--AND c.Telefono is not null
	AND ((db2.Cta_Verificada = 0 AND db2.Tel_Verificado = 0)
	OR (db2.Cta_Verificada = 1 AND db2.Tel_Verificado = 0)
	OR (db2.Cta_Verificada = 0 AND db2.Tel_Verificado = 1))" update="Detalle_Beneficiarios" updatewhere=0 updatekeyinplace=yes )

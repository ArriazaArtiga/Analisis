table(column=(type=char(8000) updatewhereclause=yes name=resolucion dbname="resolucion" )
 column=(type=char(50) updatewhereclause=yes name=contribuyentes_cuenta_bancaria dbname="contribuyentes.cuenta_bancaria" )
 column=(type=char(30) updatewhereclause=yes name=solicitud_documentos_expediente_id dbname="solicitud_documentos_expediente.id" )
 column=(type=char(254) updatewhereclause=yes name=nombre dbname="nombre" )
 retrieve="SELECT
	CONCAT( 
	convert(varchar,(CONVERT(int,SUBSTRING(s.referencia_solicitud, 1, CASE CHARINDEX('-', s.referencia_solicitud) WHEN 0 THEN LEN(s.referencia_solicitud) ELSE CHARINDEX('-', s.referencia_solicitud) - 1 END)))),
	REPLACE(SUBSTRING(s.referencia_solicitud, CASE CHARINDEX('-', s.referencia_solicitud) WHEN 0 THEN LEN(s.referencia_solicitud) + 1 ELSE CHARINDEX('-', s.referencia_solicitud) + 1 END, 1000),'-','')) Resolucion,
	c.cuenta_bancaria,
	e.dpi ID,
	CONCAT(c.Nombres,' ',c.Apellidos,' ',c.Casada)Nombre
FROM
	contribuyentes c
JOIN solicitud_documentos_expediente e ON
	c.dpi = e.dpi
JOIN solicitudes s ON
	e.no_solicitud = s.no_solicitud
WHERE
	c.cta_verificada = 1
	AND s.etapa < 210
	AND s.tipo_tramite IN ('01', '02', '03')
	AND e.tipo_documento = '9'
union
SELECT
	CONCAT( 
	convert(varchar,(CONVERT(int,SUBSTRING(s.referencia_solicitud, 1, CASE CHARINDEX('-', s.referencia_solicitud) WHEN 0 THEN LEN(s.referencia_solicitud) ELSE CHARINDEX('-', s.referencia_solicitud) - 1 END)))),
	REPLACE(SUBSTRING(s.referencia_solicitud, CASE CHARINDEX('-', s.referencia_solicitud) WHEN 0 THEN LEN(s.referencia_solicitud) + 1 ELSE CHARINDEX('-', s.referencia_solicitud) + 1 END, 1000),'-','')) Resolucion,
	db2.Cuenta_Banco,
	CONVERT (nvarchar,db2.Correlativo) ID,
	CONCAT(db2.Nombre1,' ',db2.Nombre2,' ',db2.Apellido1,' ',db2.Apellido2,'',db2.ApellidoC) nombre
FROM
	contribuyentes c
join Declaracion_Beneficiarios db on c.DPI = db.DPI_Contribuyente 
join Detalle_Beneficiarios db2  on  db.idFormulario  = db2.idFormulario 
JOIN solicitud_documentos_expediente e ON c.dpi = e.dpi
JOIN solicitudes s ON	e.no_solicitud = s.no_solicitud
WHERE
	db2.cta_verificada = 1
	AND s.etapa < 210
	AND s.tipo_tramite not IN ('01', '02', '03')
	AND e.tipo_documento = '9';" )
